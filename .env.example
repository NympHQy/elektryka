# Klucz dostępu z https://web3forms.com — wiadomości z formularza trafiają na podany tam e-mail.
# Na Vercelu: Settings → Environment Variables, potem ponowny deploy.
# Bez klucza formularz otwiera program pocztowy klienta z gotową wiadomością.
VITE_WEB3FORMS_KEY=

# Adres strony dla canonical, sitemap.xml i Open Graph. Ustaw po podpięciu własnej domeny, np. https://volcik.pl
VITE_SITE_URL=
